NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://dashboard_user:change-me@localhost:5432/personal_dashboard
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=pd.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_MS=604800000
PRESENCE_TIMEOUT_MS=120000
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Frontend-only values belong in frontend/.env.local or the frontend host configuration.
# Leave blank for same-origin development through the Vite proxy.
VITE_API_URL=
VITE_SOCKET_URL=
VITE_DEV_BACKEND_URL=http://localhost:5000
